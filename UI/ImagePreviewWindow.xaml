<Window x:Class="BetterQuickSettings.UI.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960" Height="680" MinWidth="360" MinHeight="260" Title="Image preview"
        WindowStyle="None" ResizeMode="CanResize" Background="#11141B" Foreground="#F5F7FC"
        FontFamily="Segoe UI Variable Text, Segoe UI" Language="en-US" PreviewKeyDown="OnKeyDown">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="14,0,8,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="Filename" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" FontSize="12" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="Fit" Click="FitClick" Padding="9,5" ToolTip="Fit image" />
        <Button Content="1:1" Click="ActualSizeClick" Padding="9,5" ToolTip="Actual pixels" />
        <Button Style="{StaticResource IconButton}" Click="CloseClick" ToolTip="Close · Esc"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="12" /></Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Background="#0C0F15" Margin="6,0,6,6">
      <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    PreviewMouseWheel="OnWheel" PreviewMouseLeftButtonDown="OnPanStart" PreviewMouseMove="OnPan" PreviewMouseLeftButtonUp="OnPanEnd">
        <Image x:Name="Picture" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </ScrollViewer>
      <TextBlock x:Name="Status" Text="Loading image…" Foreground="#ABB6C8" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
