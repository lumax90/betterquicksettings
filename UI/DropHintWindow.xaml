<Window x:Class="BetterQuickSettings.UI.DropHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File shelf drop target" Width="194" Height="66" Language="en-US"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Background="{StaticResource GlassFallback}"
        AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
  <Border x:Name="TargetSurface" Background="Transparent" BorderThickness="0" Padding="16,10">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="23" Margin="0,0,12,0" />
      <TextBlock Text="Drop to shelf" FontSize="13" />
    </StackPanel>
  </Border>
</Window>
