<Window x:Class="BetterQuickSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterQuickSettings" Width="344" Height="360" SizeToContent="Manual" Language="en-US"
        MinWidth="344" MaxWidth="344" MinHeight="310" WindowStyle="None" ResizeMode="NoResize" Background="{StaticResource GlassFallback}"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True"
        PreviewDragOver="OnFilesDragOver" PreviewDragLeave="OnFilesDragLeave" PreviewDrop="OnFilesDrop"
        PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated" AutomationProperties.HelpText="Drag the top edge to resize the panel.">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
  <Border x:Name="PanelSurface" Background="Transparent" BorderThickness="0">
    <Border.Resources>
      <DataTemplate x:Key="ScreenshotTile">
        <Border x:Name="ShotTile" Width="102" Height="64" Margin="0,0,5,5" BorderThickness="0" CornerRadius="9"
                Cursor="Hand" Focusable="True" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Drag to another app, or press Control+C to copy the file."
                PreviewMouseLeftButtonDown="FileMouseDown" PreviewMouseMove="FileMouseMove" PreviewMouseLeftButtonUp="FileMouseUp" KeyDown="FileKeyDown">
          <Border.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open" Click="OpenFileClick" /><MenuItem Header="Copy file" Click="CopyFileClick" />
              <MenuItem Header="Keep on shelf" Click="KeepScreenshotClick" /><Separator /><MenuItem Header="Remove" Click="RemoveFileClick" />
            </ContextMenu>
          </Border.ContextMenu>
          <Grid>
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,102,64" RadiusX="9" RadiusY="9" /></Image.Clip></Image>
            <StackPanel x:Name="ShotActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /><Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></DataTrigger>
              </Style.Triggers></Style></StackPanel.Style>
              <Button Width="22" Height="22" Margin="0,0,3,0" Background="#E0212833" Padding="0" Click="KeepScreenshotClick" ToolTip="Keep on shelf" AutomationProperties.Name="Keep screenshot on shelf"><TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" Foreground="#F5F7FC" FontSize="10" /></Button>
              <Button Width="22" Height="22" Background="#E0212833" Padding="0" Click="RemoveFileClick" ToolTip="Remove" AutomationProperties.Name="Remove screenshot"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" Foreground="#F5F7FC" FontSize="9" /></Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="NoteRow">
        <Button Click="EditNoteClick" HorizontalContentAlignment="Stretch" Padding="11,9" Margin="0,0,0,6" Background="{DynamicResource GlassCell}" AutomationProperties.Name="{Binding Title}">
          <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Delete note" Click="DeleteNoteClick" /></ContextMenu></Button.ContextMenu>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Excerpt}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ModifiedLabel}" Style="{StaticResource Caption}" FontSize="9" VerticalAlignment="Top" Margin="0,2,0,0" />
          </Grid>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="HeldFileRow">
        <Border Margin="0,0,0,5" Padding="8,6" Background="{DynamicResource GlassCell}" BorderThickness="0" CornerRadius="11"
                Cursor="Hand" Focusable="True" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Drag to another app, or press Control+C to copy the file."
                PreviewMouseLeftButtonDown="FileMouseDown" PreviewMouseMove="FileMouseMove" PreviewMouseLeftButtonUp="FileMouseUp" KeyDown="FileKeyDown">
          <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Open" Click="OpenFileClick" /><MenuItem Header="Copy file" Click="CopyFileClick" /><Separator /><MenuItem Header="Remove from shelf" Click="RemoveFileClick" /></ContextMenu></Border.ContextMenu>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
            <Grid Width="27" Height="27"><TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" /><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,27,27" RadiusX="5" RadiusY="5" /></Image.Clip></Image></Grid>
            <StackPanel Grid.Column="1" Margin="7,0,5,0"><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="9" Margin="0,2,0,0" /></StackPanel>
            <Button Grid.Column="2" Width="24" Height="24" Padding="0" Click="RemoveFileClick" ToolTip="Remove from shelf" AutomationProperties.Name="Remove file from shelf"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="9" /></Button>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="ClipboardRow">
        <Border CornerRadius="12" Background="{DynamicResource GlassCell}" Margin="0,0,0,6">
          <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Copy" Click="CopyClipboardClick" />
            <MenuItem Header="Preview image" Click="PreviewClipboardImageClick" Visibility="{Binding IsImage, Converter={StaticResource VisibleIf}}" />
            <Separator /><MenuItem Header="Delete" Click="RemoveClipboardClick" />
          </ContextMenu></Border.ContextMenu>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
            <Button Click="CopyClipboardClick" Padding="10,9,4,9" HorizontalContentAlignment="Stretch" ToolTip="{Binding CopyLabel}" AutomationProperties.Name="{Binding Preview}" AutomationProperties.HelpText="Copy this history item to the clipboard.">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="58" Height="48" Margin="0,0,9,0" Visibility="{Binding IsImage, Converter={StaticResource VisibleIf}}"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,58,48" RadiusX="6" RadiusY="6" /></Image.Clip></Image></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Preview}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="43" />
                  <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="9" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource Caption}" FontSize="9" Margin="6,0,0,0" /></Grid>
                </StackPanel>
              </Grid>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /><Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></DataTrigger>
              </Style.Triggers></Style></StackPanel.Style>
              <Button Width="24" Height="24" Padding="0" Click="PreviewClipboardImageClick" ToolTip="Preview image" AutomationProperties.Name="Preview clipboard image" Visibility="{Binding IsImage, Converter={StaticResource VisibleIf}}"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="11" /></Button>
              <Button Width="24" Height="24" Padding="0" Click="RemoveClipboardClick" ToolTip="Delete" AutomationProperties.Name="Delete clipboard item"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="9" /></Button>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </Border.Resources>
    <Grid>
    <Thumb x:Name="PanelResizeGrip" Height="9" Margin="8,0" VerticalAlignment="Top" Cursor="SizeNS" Focusable="False"
           DragStarted="PanelResizeStarted" DragDelta="PanelResizeDelta" DragCompleted="PanelResizeCompleted"
           ToolTip="Drag to resize height" AutomationProperties.Name="Resize panel height">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="28" Height="2" CornerRadius="1" Background="{DynamicResource Muted}" Opacity="0.4" VerticalAlignment="Top" Margin="0,3,0,0" /></Grid></ControlTemplate></Thumb.Template>
    </Thumb>
    <Grid x:Name="PanelContent" Margin="11">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border x:Name="HeaderFrame" Margin="0,0,0,9" CornerRadius="14" Background="{DynamicResource GlassHeader}"><Grid Height="30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border CornerRadius="14" Padding="2" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ControlsTab" Content="Controls" GroupName="Pages" IsChecked="True" Checked="ControlsChecked" AutomationProperties.Name="Controls" />
            <RadioButton x:Name="NotesTab" Content="Notes" GroupName="Pages" Checked="NotesChecked" AutomationProperties.Name="Quick notes" />
            <RadioButton x:Name="FilesTab" Content="Files" GroupName="Pages" Checked="FilesChecked" AutomationProperties.Name="File shelf" />
            <RadioButton x:Name="ClipboardTab" Content="History" GroupName="Pages" Checked="ClipboardChecked" ToolTip="Clipboard history · Ctrl + H" AutomationProperties.Name="Clipboard history" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="PreferencesButton" Style="{StaticResource IconButton}" Click="PreferencesClick" ToolTip="Preferences" AutomationProperties.Name="Preferences"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" /></Button>
          <Button Style="{StaticResource IconButton}" Click="DismissClick" ToolTip="Close · Esc" AutomationProperties.Name="Close panel"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="11" /></Button>
        </StackPanel>
      </Grid></Border>
      <Grid x:Name="PageHost" Grid.Row="1" ClipToBounds="True">
        <ScrollViewer x:Name="ControlsPage" Style="{StaticResource PanelPageScroll}">
          <Grid x:Name="ControlsLayout" MinHeight="{Binding ViewportHeight, ElementName=ControlsPage}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel x:Name="ControlsAboveScreenshot">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,3">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="33" /></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource IconButton}" Click="MuteClick" IsEnabled="{Binding AudioAvailable}" ToolTip="Mute / unmute" AutomationProperties.Name="Mute or unmute"><TextBlock Text="{Binding VolumeGlyph}" Style="{StaticResource Glyph}" FontSize="16" /></Button>
                  <Slider x:Name="VolumeSlider" Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding AudioAvailable}" Margin="6,0,4,0" ToolTip="Volume" AutomationProperties.Name="Volume" />
                  <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="10" />
                </Grid>
                <Button Click="OutputClick" HorizontalContentAlignment="Stretch" Padding="4,3" Margin="29,1,0,0" ToolTip="Audio output" AutomationProperties.Name="Select audio output">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions><TextBlock Text="{Binding OutputName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="8" Foreground="{DynamicResource Muted}" /></Grid>
                </Button>
                <StackPanel x:Name="OutputPicker" Visibility="Collapsed" Margin="0,5,0,2">
                  <Grid Margin="4,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><TextBlock Text="Audio output" Style="{StaticResource Caption}" /><Button Grid.Column="1" Style="{StaticResource IconButton}" Tag="sound" Click="SettingsClick" ToolTip="Windows sound settings" AutomationProperties.Name="Open Windows sound settings"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="13" /></Button></Grid>
                  <ItemsControl ItemsSource="{Binding Outputs}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                      <Button Click="SelectOutputClick" Tag="{Binding}" HorizontalContentAlignment="Stretch" Padding="5,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource Accent}" Visibility="{Binding IsDefault, Converter={StaticResource VisibleIf}}" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" /></Grid></Button>
                      <Button Grid.Column="1" Click="PreferHeadphonesClick" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="Use for automatic switching" AutomationProperties.Name="Set preferred headphones"><TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" FontSize="13" /></Button>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <CheckBox IsChecked="{Binding AutoHeadphones}" Margin="4,3,2,0" AutomationProperties.Name="Switch to headphones automatically"><TextBlock Text="Auto-switch to headphones" FontSize="11" /></CheckBox>
                </StackPanel>
                <Border Height="1" Background="#1FFFFFFF" Margin="3,6,3,8" />
                <Grid ToolTip="{Binding BrightnessDescription}"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="33" /></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" /><Slider Grid.Column="1" Value="{Binding Brightness, Mode=TwoWay}" IsEnabled="{Binding BrightnessAvailable}" Margin="6,0,4,0" AutomationProperties.Name="Display brightness" /><TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="10" Visibility="{Binding BrightnessAvailable, Converter={StaticResource VisibleIf}}" />
                </Grid>
              </StackPanel>
            </Border>
            <Expander x:Name="ToolsExpander" IsExpanded="{Binding ToolsExpanded, Mode=TwoWay}" Expanded="ToolsChanged" Collapsed="ToolsChanged">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource Tile}" Margin="0,0,6,6" Tag="network-wifi" Click="SettingsClick" ToolTip="{Binding Network}" AutomationProperties.Name="Open Wi-Fi settings"><StackPanel><Grid><TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" Foreground="#C5E3F9" /><TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#86BAC9DB" FontSize="9" /></Grid><TextBlock Text="Wi-Fi" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel></Button>
                <Button Grid.Column="1" Style="{StaticResource Tile}" Margin="0,0,6,6" Tag="bluetooth" Click="SettingsClick" ToolTip="{Binding Bluetooth}" AutomationProperties.Name="Open Bluetooth settings"><StackPanel><Grid><TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" Foreground="#BAD6FF" /><TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#86BAC9DB" FontSize="9" /></Grid><TextBlock Text="Bluetooth" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel></Button>
                <Button Grid.Column="2" Style="{StaticResource Tile}" Margin="0,0,0,6" Tag="nightlight" Click="SettingsClick" ToolTip="Night light settings" AutomationProperties.Name="Open night light settings"><StackPanel><Grid><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" Foreground="#F0D7AE" /><TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#86BAC9DB" FontSize="9" /></Grid><TextBlock Text="Night light" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel></Button>
                <Button Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,6,0" Click="CastClick" ToolTip="Cast to a display" AutomationProperties.Name="Cast to a display"><StackPanel><TextBlock Text="&#xEBC4;" Style="{StaticResource Glyph}" /><TextBlock Text="Cast" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel></Button>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}" Margin="0,0,6,0" Click="FocusClick" ToolTip="{Binding FocusLabel}" AutomationProperties.Name="Start or stop focus timer"><StackPanel><TextBlock Text="&#xE916;" Style="{StaticResource Glyph}" Foreground="#D9CDFB" /><TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Focus" /><Style.Triggers><DataTrigger Binding="{Binding FocusRunning}" Value="True"><Setter Property="Text" Value="{Binding FocusLabel}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}" Tag="" Click="SettingsClick" ToolTip="Windows settings" AutomationProperties.Name="Open Windows settings"><StackPanel><Grid><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" /><TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#86BAC9DB" FontSize="9" /></Grid><TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" /></StackPanel></Button>
              </Grid>
            </Expander>
            <Border Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,5,0,0" Visibility="{Binding Media.Available, Converter={StaticResource VisibleIf}}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="#32485B"><Grid><Ellipse Width="29" Height="29" Fill="#233143" Stroke="#7799BA" StrokeThickness="0.7" /><Ellipse Width="11" Height="11" Fill="#BBD2E9" /><Ellipse Width="3" Height="3" Fill="#324559" /><Image Source="{Binding Media.Artwork}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="10" RadiusY="10" /></Image.Clip></Image></Grid></Border>
                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center" ToolTip="{Binding Media.Source}"><TextBlock Text="{Binding Media.Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Media.Artist}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Width="24" Height="28" Padding="0" Click="PreviousClick" IsEnabled="{Binding Media.CanPrevious}" AutomationProperties.Name="Previous track" ToolTip="Previous track"><TextBlock Text="&#xE892;" Style="{StaticResource Glyph}" FontSize="11" /></Button>
                  <Button Width="29" Height="29" Padding="0" Background="#24FFFFFF" BorderBrush="{StaticResource CellEdge}" Click="PlayClick" IsEnabled="{Binding Media.CanPlay}" AutomationProperties.Name="Play or pause" ToolTip="Play / pause"><TextBlock Text="{Binding PlayGlyph}" Style="{StaticResource Glyph}" FontSize="12" /></Button>
                  <Button Width="24" Height="28" Padding="0" Click="NextClick" IsEnabled="{Binding Media.CanNext}" AutomationProperties.Name="Next track" ToolTip="Next track"><TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="11" /></Button>
                </StackPanel>
              </Grid>
            </Border>
            </StackPanel>
            <Grid x:Name="LatestScreenshotPreviewHost" Grid.Row="1" Margin="0,6,0,0" Background="{DynamicResource GlassCell}" Visibility="{Binding HasScreenshots, Converter={StaticResource VisibleIf}}" SizeChanged="ScreenshotPreviewSizeChanged">
              <Grid DataContext="{Binding LatestScreenshot}" Cursor="Hand" Focusable="True" ToolTip="Open or drag screenshot" AutomationProperties.Name="Latest screenshot" PreviewMouseLeftButtonDown="FileMouseDown" PreviewMouseMove="FileMouseMove" PreviewMouseLeftButtonUp="FileMouseUp" KeyDown="FileKeyDown">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="10,2,5,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Latest screenshot" FontSize="10" />
                  <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource Caption}" FontSize="9" Margin="7,0" />
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OpenFilesClick" ToolTip="All files" AutomationProperties.Name="Show all files"><TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="11" /></Button>
                </Grid>
                <Image x:Name="LatestScreenshotImage" Grid.Row="1" Source="{Binding DataContext.LatestScreenshotPreview, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Stretch="Uniform" />
              </Grid>
            </Grid>
          </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="NotesPage" Style="{StaticResource PanelPageScroll}" Visibility="Collapsed"><StackPanel>
            <StackPanel Visibility="{Binding IsComposingNote, Converter={StaticResource VisibleIf}}">
              <Border Style="{StaticResource CardBorder}"><StackPanel>
                <Grid>
                  <TextBox x:Name="NoteComposer" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding NoteReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="112" VerticalScrollBarVisibility="Auto" MaxLength="200000" AutomationProperties.Name="New note" />
                  <TextBlock Text="New note…" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="2,3,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Note}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
                <Button x:Name="AddNoteButton" Content="Add" Click="AddNoteClick" IsEnabled="{Binding CanAddNote}" HorizontalAlignment="Right" Background="#254980B5" Padding="13,5" ToolTip="Add note · Ctrl + Enter" AutomationProperties.Name="Add note" />
              </StackPanel></Border>
              <ItemsControl x:Name="NotesList" ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteRow}" Margin="0,8,0,0" />
              <TextBlock Text="No notes yet" HorizontalAlignment="Center" Margin="0,13,0,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
            <Grid MinHeight="160" Height="{Binding ViewportHeight, ElementName=NotesPage}" Visibility="{Binding IsEditingNote, Converter={StaticResource VisibleIf}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Click="NotesBackClick" ToolTip="Back to notes" AutomationProperties.Name="Back to notes"><TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="13" /></Button>
                <TextBlock Grid.Column="1" Text="{Binding EditingNoteLabel}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Click="CopyNoteClick" ToolTip="Copy note"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" /></Button><Button Style="{StaticResource IconButton}" Click="DeleteNoteClick" ToolTip="Delete note" AutomationProperties.Name="Delete current note"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" /></Button></StackPanel>
              </Grid>
              <Border Grid.Row="1" Style="{StaticResource CardBorder}" MinHeight="84"><TextBox x:Name="NoteEditor" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding NoteReadOnly}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="200000" AutomationProperties.Name="Edit note" /></Border>
              <TextBlock Grid.Row="2" Text="{Binding NoteStatus}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,4,0" />
            </Grid>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="FilesPage" Style="{StaticResource PanelPageScroll}" Visibility="Collapsed"><StackPanel>
            <Grid Margin="3,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Screenshots" FontSize="11" /><Button Grid.Column="1" Style="{StaticResource IconButton}" Click="CaptureClick" ToolTip="Take a screenshot" AutomationProperties.Name="Take a screenshot"><TextBlock Text="&#xE722;" Style="{StaticResource Glyph}" FontSize="15" /></Button></Grid>
            <ItemsControl x:Name="ScreenshotGallery" ItemsSource="{Binding RecentScreenshots}" ItemTemplate="{StaticResource ScreenshotTile}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
            <TextBlock Text="No screenshots yet" Margin="3,3,0,13"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasScreenshots}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Grid Margin="3,8,3,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Shelf" FontSize="11" /><TextBlock Grid.Column="1" Text="Copying…" Style="{StaticResource Caption}" Visibility="{Binding AddingFiles, Converter={StaticResource VisibleIf}}" /></Grid>
            <ItemsControl ItemsSource="{Binding HeldFiles}" ItemTemplate="{StaticResource HeldFileRow}" />
            <Border BorderBrush="#34C5D8F0" BorderThickness="1" CornerRadius="12" Background="#08FFFFFF" Padding="12" Margin="0,2,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,0,8,0" /><TextBlock Text="Drop files here" Style="{StaticResource Caption}" /></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="ClipboardPage" Style="{StaticResource PanelPageScroll}" Visibility="Collapsed"><StackPanel>
            <Grid Margin="3,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
              <TextBlock Text="Clipboard" FontSize="11" />
              <TextBlock Grid.Column="1" Text="{Binding ClipboardSummary}" Style="{StaticResource Caption}" Margin="0,0,8,0" ToolTip="Up to 50 items and 32 MB, saved on this device" />
              <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="ClearClipboardClick" IsEnabled="{Binding HasClipboardItems}" ToolTip="Clear history" AutomationProperties.Name="Clear clipboard history"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" /></Button>
            </Grid>
            <Border CornerRadius="11" Background="{DynamicResource GlassCell}" Padding="9,5" Margin="0,0,0,8">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" />
                <Grid Grid.Column="1">
                  <TextBox x:Name="ClipboardSearchBox" Text="{Binding ClipboardSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" FontSize="11" MaxLength="200" AutomationProperties.Name="Search clipboard history" />
                  <TextBlock Text="Search history" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,0,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ClipboardSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding ClipboardItems}" ItemTemplate="{StaticResource ClipboardRow}" />
            <TextBlock Text="{Binding ClipboardEmptyMessage}" TextAlignment="Center" TextWrapping="Wrap" Margin="8,24"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HasClipboardResults}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="PreferencesPage" Style="{StaticResource PanelPageScroll}" Visibility="Collapsed"><StackPanel>
            <Border Style="{StaticResource CardBorder}"><StackPanel>
              <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Glass" /><TextBlock Grid.Column="1" Text="{Binding GlassLabel}" Style="{StaticResource Caption}" /></Grid>
              <Slider x:Name="GlassSlider" Value="{Binding GlassAmount, Mode=TwoWay}" ToolTip="Glass transparency · zero turns it off" AutomationProperties.Name="Glass intensity" Margin="0,0,0,8" />
              <Border Height="1" Background="#12FFFFFF" Margin="0,0,0,5" />
              <CheckBox IsChecked="{Binding ReplaceQuickSettings}" ToolTip="{Binding IntegrationStatus}" AutomationProperties.Name="Replace Quick Settings"><TextBlock Text="Replace Quick Settings" /></CheckBox><Border Height="1" Background="#1FFFFFFF" Margin="0,5" />
              <CheckBox IsChecked="{Binding AutoHeadphones}" ToolTip="Use newly connected headphones as the audio output" AutomationProperties.Name="Switch to headphones automatically"><TextBlock Text="Auto-switch headphones" /></CheckBox><Border Height="1" Background="#1FFFFFFF" Margin="0,5" />
              <CheckBox IsChecked="{Binding VolumeFeedbackEnabled}" ToolTip="Play a short tap when the volume slider is released" AutomationProperties.Name="Volume feedback sound"><TextBlock Text="Volume feedback" /></CheckBox><Border Height="1" Background="#1FFFFFFF" Margin="0,5" />
              <CheckBox IsChecked="{Binding ClipboardHistoryEnabled}" ToolTip="Remember copied text and images on this device" AutomationProperties.Name="Save clipboard history"><TextBlock Text="Clipboard history" /></CheckBox><Border Height="1" Background="#1FFFFFFF" Margin="0,5" />
              <CheckBox x:Name="StartupCheck" Click="StartupClick"><TextBlock Text="Start with Windows" /></CheckBox><Border Height="1" Background="#1FFFFFFF" Margin="0,5" />
              <CheckBox x:Name="PinCheck" ToolTip="Keep the panel open when clicking outside"><TextBlock Text="Keep panel open" /></CheckBox><Border Height="1" Background="#1FFFFFFF" Margin="0,5" />
              <Button Click="ScreenshotFolderClick" HorizontalContentAlignment="Stretch" Padding="0,5" ToolTip="Choose an additional screenshot folder" AutomationProperties.Name="Choose screenshot folder"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Screenshot folder" FontSize="11" /><TextBlock Text="{Binding ScreenshotFolderLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="14" /></Grid></Button>
            </StackPanel></Border>
            <Button x:Name="QuitButton" Click="QuitClick" Content="Exit" HorizontalAlignment="Right" Margin="0,7,0,0" Padding="13,5" />
        </StackPanel></ScrollViewer>
      </Grid>
      <Border x:Name="NoticePanel" Grid.Row="2" Background="#C0473B2B" CornerRadius="10" Padding="9" Margin="0,7,0,0" Visibility="{Binding HasNotice, Converter={StaticResource VisibleIf}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="#F1DDC0" FontSize="11" TextWrapping="Wrap" /><Button Grid.Column="1" Content="×" Click="ClearNoticeClick" Padding="0" AutomationProperties.Name="Dismiss message" /></Grid></Border>
      <Border Grid.RowSpan="3" Background="#ED344960" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="14" IsHitTestVisible="False" Visibility="{Binding FileDragOver, Converter={StaticResource VisibleIf}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="28" /><TextBlock Text="Drop to shelf" Margin="0,10,0,0" HorizontalAlignment="Center" /></StackPanel></Border>
    </Grid>
    </Grid>
  </Border>
</Window>
